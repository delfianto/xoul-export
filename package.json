{
  "name": "xoul-export",
  "version": "1.0.0",
  "private": true,
  "description": "Export open Xoul.AI chats to Markdown or JSON — MV3 browser extension",
  "type": "module",
  "scripts": {
    "build": "vp build",
    "build:firefox": "BROWSER=firefox vp build",
    "dev": "vp build --watch",
    "dev:firefox": "BROWSER=firefox vp build --watch",
    "check": "vp check && tsc -p tsconfig.json",
    "lint": "vp lint src/",
    "fmt": "vp fmt src/",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "export-chat": "bun run scripts/export-chat.ts"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/chrome": "^0.3.0",
    "@types/webextension-polyfill": "^0.12.5",
    "happy-dom": "^20.10.6",
    "typescript": "^7.0.2",
    "vite-plugin-web-extension": "^4.5.1",
    "vite-plus": "^0.3.0"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
